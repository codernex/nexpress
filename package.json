{
  "name": "@codernex/nexpress",
  "version": "1.0.7",
  "description": "Multi-threaded image batch processor CLI",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "nexpress": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
