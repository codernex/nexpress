{
  "name": "nexpress",
  "version": "1.0.0",
  "description": "Multi-threaded image batch processor CLI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nexpress": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --loader ts-node/esm src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "image-processing",
    "cli",
    "sharp",
    "worker-threads"
  ],
  "author": "@codernex",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "sharp": "^0.34.5",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsc": "^2.0.4",
    "typescript": "^5.7.3"
  }
}
